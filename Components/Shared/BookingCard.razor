<div class="card mb-3 shadow-sm booking-card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-8">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h5 class="mb-1">@Booking.Schedule.Train.TrainName</h5>
                        <small class="text-muted">#@Booking.Schedule.Train.TrainNumber</small>
                    </div>
                    <span class="badge @GetStatusBadgeClass()">@Booking.Status</span>
                </div>

                <div class="row mt-3">
                    <div class="col-sm-6 mb-2">
                        <strong>PNR:</strong> @Booking.PNR
                    </div>
                    <div class="col-sm-6 mb-2">
                        <strong>Travel Date:</strong> @Booking.TravelDate.ToString("dd MMM yyyy")
                    </div>
                    <div class="col-sm-6 mb-2">
                        <strong>From:</strong> @Booking.Schedule.OriginStation.Name
                    </div>
                    <div class="col-sm-6 mb-2">
                        <strong>To:</strong> @Booking.Schedule.DestinationStation.Name
                    </div>
                    <div class="col-sm-6 mb-2">
                        <strong>Passengers:</strong> @Booking.Passengers.Count
                    </div>
                    <div class="col-sm-6 mb-2">
                        <strong>Total Amount:</strong> <span class="text-primary fw-bold">₹@Booking.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <div class="col-md-4 d-flex flex-column justify-content-center align-items-end">
                @if (ShowActions)
                {
                    <button class="btn btn-outline-primary mb-2 w-100" @onclick="OnViewDetails">
                        <i class="bi bi-eye me-2"></i>View Details
                    </button>
                    
                    @if (Booking.Status == BookingStatus.Confirmed && Booking.TravelDate > DateTime.Today)
                    {
                        <button class="btn btn-outline-danger w-100" @onclick="OnCancel">
                            <i class="bi bi-x-circle me-2"></i>Cancel Booking
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Booking Booking { get; set; } = null!;

    [Parameter]
    public bool ShowActions { get; set; } = true;

    [Parameter]
    public EventCallback OnViewDetails { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string GetStatusBadgeClass()
    {
        return Booking.Status switch
        {
            BookingStatus.Confirmed => "bg-success",
            BookingStatus.Cancelled => "bg-danger",
            BookingStatus.Completed => "bg-secondary",
            _ => "bg-info"
        };
    }
}

<style>
    .booking-card {
        transition: transform 0.2s;
    }

    .booking-card:hover {
        transform: translateY(-2px);
    }
</style>
