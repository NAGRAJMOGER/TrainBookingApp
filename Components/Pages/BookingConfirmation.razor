@page "/booking-confirmation"
@rendermode InteractiveServer
@inject IBookingService BookingService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Booking Confirmed - TrainBookingApp</PageTitle>

<div class="container mt-4">
    @if (booking == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg border-0 mb-4">
                    <div class="card-body text-center p-5">
                        <div class="mb-4">
                            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                        </div>
                        <h2 class="text-success mb-3">Booking Confirmed!</h2>
                        <p class="lead text-muted mb-4">Your train ticket has been booked successfully.</p>
                        
                        <div class="alert alert-success d-inline-block">
                            <h4 class="mb-0">PNR: <strong>@booking.PNR</strong></h4>
                        </div>

                        <div class="mt-4">
                            <small class="text-muted">
                                <i class="bi bi-envelope me-2"></i>
                                Booking details have been sent to <strong>@GetPrimaryPassengerEmail()</strong>
                            </small>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Journey Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6>Train Information</h6>
                                <p class="mb-1"><strong>Train:</strong> @booking.Schedule.Train.TrainName</p>
                                <p class="mb-1"><strong>Number:</strong> @booking.Schedule.Train.TrainNumber</p>
                                <p class="mb-1"><strong>Class:</strong> @booking.Schedule.SeatClass</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6>Journey Information</h6>
                                <p class="mb-1"><strong>From:</strong> @booking.Schedule.OriginStation.Name</p>
                                <p class="mb-1"><strong>To:</strong> @booking.Schedule.DestinationStation.Name</p>
                                <p class="mb-1"><strong>Date:</strong> @booking.TravelDate.ToString("dd MMM yyyy")</p>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-md-6 mb-3">
                                <h6>Timing</h6>
                                <p class="mb-1"><strong>Departure:</strong> @booking.Schedule.DepartureTime.ToString(@"hh\:mm")</p>
                                <p class="mb-1"><strong>Arrival:</strong> @booking.Schedule.ArrivalTime.ToString(@"hh\:mm")</p>
                                <p class="mb-1"><strong>Duration:</strong> @FormatDuration(booking.Schedule.Duration)</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6>Payment</h6>
                                <p class="mb-1"><strong>Booking Date:</strong> @booking.BookingDate.ToString("dd MMM yyyy HH:mm")</p>
                                <p class="mb-1"><strong>Total Amount:</strong> <span class="text-primary fw-bold">₹@booking.TotalAmount.ToString("N2")</span></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Passenger Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>S.No</th>
                                        <th>Name</th>
                                        <th>Age</th>
                                        <th>Gender</th>
                                        <th>Seat Number</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < booking.Passengers.Count; i++)
                                    {
                                        var passenger = booking.Passengers.ElementAt(i);
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td>@passenger.FullName</td>
                                            <td>@passenger.Age</td>
                                            <td>@passenger.Gender</td>
                                            <td><span class="badge bg-primary">@passenger.SeatNumber</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-body text-center">
                        <div class="qr-code-container mb-3">
                            <div class="border p-4 d-inline-block bg-white">
                                <div style="font-size: 80px; font-family: monospace;">
                                    <i class="bi bi-qr-code"></i>
                                </div>
                                <p class="mb-0 mt-2"><small>PNR: @booking.PNR</small></p>
                            </div>
                        </div>
                        <p class="text-muted mb-0">
                            <small>Scan this QR code at the station for verification</small>
                        </p>
                    </div>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-md-4">
                        <button class="btn btn-primary w-100" @onclick="PrintTicket">
                            <i class="bi bi-printer me-2"></i>Print Ticket
                        </button>
                    </div>
                    <div class="col-md-4">
                        <a href="/my-bookings" class="btn btn-outline-primary w-100">
                            <i class="bi bi-list-ul me-2"></i>View All Bookings
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/search" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-search me-2"></i>Book Another Ticket
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int BookingId { get; set; }

    private Booking? booking;

    protected override async Task OnInitializedAsync()
    {
        if (BookingId <= 0)
        {
            NavigationManager.NavigateTo("/search");
            return;
        }

        booking = await BookingService.GetBookingByIdAsync(BookingId);
    }

    private string GetPrimaryPassengerEmail()
    {
        return booking?.Passengers.FirstOrDefault()?.Email ?? "N/A";
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.Hours > 0)
            return $"{duration.Hours}h {duration.Minutes}m";
        return $"{duration.Minutes}m";
    }

    private async Task PrintTicket()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
