@page "/"

<PageTitle>Home - TrainBookingApp</PageTitle>

<div class="hero-section py-5 bg-primary text-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">Book Your Train Tickets</h1>
                <p class="lead mb-4">Fast, easy, and secure online train ticket booking. Find trains, check availability, and book tickets in just a few clicks!</p>
                <a href="/search" class="btn btn-light btn-lg">
                    <i class="bi bi-search me-2"></i>Search Trains
                </a>
            </div>
            <div class="col-lg-6 text-center">
                <i class="bi bi-train-front display-1"></i>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row text-center mb-5">
        <div class="col-12">
            <h2 class="mb-3">Why Choose Us?</h2>
            <p class="text-muted">Experience the best train booking service</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-lightning-charge-fill text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Quick Booking</h5>
                    <p class="card-text text-muted">Book your tickets in less than 5 minutes with our streamlined booking process.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-shield-check text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Secure Payment</h5>
                    <p class="card-text text-muted">Your transactions are protected with industry-standard security measures.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-headset text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">24/7 Support</h5>
                    <p class="card-text text-muted">Our customer support team is available round the clock to assist you.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-person-circle text-primary me-2"></i>
                        For Registered Users
                    </h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>View booking history</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Quick booking with saved details</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Easy cancellation and refunds</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Email notifications</li>
                    </ul>
                    <AuthorizeView>
                        <Authorized>
                            <a href="/search" class="btn btn-primary">Book Now</a>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/register" class="btn btn-primary">Sign Up Now</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        How It Works
                    </h5>
                    <ol class="mb-0">
                        <li class="mb-2">Search for trains between your origin and destination</li>
                        <li class="mb-2">Select your preferred train and class</li>
                        <li class="mb-2">Choose your seats from the seat map</li>
                        <li class="mb-2">Enter passenger details</li>
                        <li class="mb-2">Review and confirm your booking</li>
                        <li class="mb-2">Receive your e-ticket via email</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
    }
</style>
